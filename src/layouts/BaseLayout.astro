---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { AMAZON } from '../config';

type Props = Parameters<typeof BaseHead>[0];
const props = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script is:inline>
      (function () {
        function expire() {
          var now = Date.now();
          document.querySelectorAll('[data-amazon-updated]').forEach(function (el) {
            var age = now - Date.parse(el.getAttribute('data-amazon-updated') || '');
            if (!Number.isFinite(age) || age < 0 || age >= 23 * 3600000) el.remove();
          });
        }
        expire(); setInterval(expire, 30000);
        document.addEventListener('visibilitychange', expire);
        window.addEventListener('pageshow', expire);
      })();
    </script>
    <style>
      .skip { position: absolute; left: -999px; top: 8px; background: #fff; padding: 8px 12px; z-index: 100; }
      .skip:focus { left: 8px; }
      main { min-height: 60vh; }
    </style>
  </body>
</html>
