---
import guides from '../data/reader-guides.json';
interface Props { guideKey: string; part: 'intro' | 'decision' }
const { guideKey, part } = Astro.props;
const guide = (guides as Record<string, {fit:string;benefit:string;limit:string;checks:string[]}>)[guideKey];
if (!guide) throw new Error(`Missing reader guide: ${guideKey}`);
---
{part === 'intro' ? (
  <section class="reader-guide" id="fuer-wen" aria-labelledby="reader-fit-title" data-reader-intro>
    <h2 id="reader-fit-title">Für wen ist das sinnvoll?</h2>
    <p>{guide.fit}</p>
  </section>
) : (
  <div class="reader-guide" data-reader-decision>
    <section id="vorteile-und-grenzen" aria-labelledby="reader-tradeoff-title">
      <h2 id="reader-tradeoff-title">Vorteile und Grenzen abwägen</h2>
      <div class="tradeoffs">
        <div><h3>Was dafür spricht</h3><p>{guide.benefit}</p></div>
        <div><h3>Was du bedenken solltest</h3><p>{guide.limit}</p></div>
      </div>
    </section>
    <section id="deine-auswahl" aria-labelledby="reader-check-title">
      <h2 id="reader-check-title">Deine Auswahlhilfe vor dem Kauf</h2>
      <p>Halte diese Punkte für deinen Bedarf fest. Danach kannst du konkrete Modelle gezielt abgleichen.</p>
      <ol>{guide.checks.map(check => <li>{check}</li>)}</ol>
      <p class="small muted">Wenn die vorhandene Ausstattung deinen Bedarf bereits erfüllt, ist ein Neukauf nicht allein wegen zusätzlicher Funktionen nötig.</p>
    </section>
  </div>
)}
<style>
  .reader-guide { max-width: var(--prose, 800px); margin: 28px 0; line-height: 1.75; }
  .reader-guide section, .reader-guide[id] { scroll-margin-top: 140px; }
  h2 { margin: 0 0 14px; font-size: clamp(1.4rem, 3vw, 1.9rem); }
  h3 { margin: 0 0 8px; font-size: 1.05rem; }
  p { margin: 0 0 16px; }
  .tradeoffs { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 32px; }
  .tradeoffs > div { border-top: 2px solid var(--border); padding-top: 16px; }
  ol { padding-left: 1.4em; }
  li { margin: 10px 0; }
  @media(max-width:600px) { .tradeoffs { grid-template-columns: 1fr; gap: 6px; } }
</style>
