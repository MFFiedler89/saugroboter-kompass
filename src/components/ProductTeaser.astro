---
/** Kompakte Produktreihe aus einer Vergleichsseite, für Ratgeber, Situationen, Hubs.
 *  <ProductTeaser sub="saugroboter-mit-absaugstation" />  oder mit Filter: filter="wischsystem=Mopprolle" */
import { getProducts, subBySlug, subUrl, shortTitle } from '../lib/catalog';
import PriceBlock from './PriceBlock.astro';
import ProductImg from './ProductImg.astro';
interface Props { sub: string; limit?: number; title?: string; filter?: string }
const { sub, limit = 3, title, filter } = Astro.props;
const s = subBySlug[sub];
if (!s) throw new Error(`ProductTeaser: Unterkategorie "${sub}" unbekannt`);
let list = getProducts(sub);
if (filter) {
  const [k, v] = filter.split('=');
  list = list.filter((p) => String(p.specs[k] === true ? 'ja' : p.specs[k]) === v);
}
const picksFirst = [...list.filter((p) => p.pick), ...list.filter((p) => !p.pick)].slice(0, limit);
---
{picksFirst.length > 0 && (
  <aside class="pt card">
    <div class="head">
      <p class="t">{title ?? `Beliebte ${s.label}`}</p>
      <a href={subUrl(sub)} class="all">Alle {getProducts(sub).length} vergleichen →</a>
    </div>
    <div class="row">
      {picksFirst.map((p) => (
        <div class="it">
          <div class="img"><ProductImg product={p} size={90} /></div>
          <div>
            {p.pick && <span class="pk">{p.pick.label}</span>}
            <a class="nm" href={p.url} rel="sponsored nofollow noopener" target="_blank">{shortTitle(p.title, 60)}</a>
            <PriceBlock product={p} compact showTier={false} />
          </div>
        </div>
      ))}
    </div>
    <p class="ad small muted">Anzeige · Links zu Amazon</p>
  </aside>
)}
<style>
  .pt { padding: 16px 18px; margin: 26px 0; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .t { font-weight: 800; margin: 0; }
  .all { font-size: .88rem; font-weight: 600; }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .it { display: grid; grid-template-columns: 80px 1fr; gap: 12px; align-items: start; }
  .img :global(.pimg), .img :global(.ph) { width: 80px; height: 80px !important; }
  .pk { display: inline-block; font-size: .65rem; font-weight: 700; background: var(--brand); color: #fff; padding: 1px 7px; border-radius: 999px; margin-bottom: 3px; }
  .nm { display: block; font-size: .85rem; font-weight: 600; color: var(--text); text-decoration: none; line-height: 1.3; margin-bottom: 4px; }
  .nm:hover { color: var(--brand); }
  .ad { margin: 10px 0 0; font-size: .7rem; }
</style>
