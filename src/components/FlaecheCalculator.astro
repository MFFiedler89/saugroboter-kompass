---
/**
 * Rechner: Wie lange braucht ein Saugroboter fuer meine Wohnflaeche, und
 * reicht eine Akkuladung?
 *
 * Wichtig: Die Flaechenleistung je Minute ist eine Annahme, kein Messwert.
 * Sie ist deshalb einstellbar und wird im Ergebnis offen benannt.
 */
---
<section class="calc card" data-flaeche aria-labelledby="fl-h">
  <h2 id="fl-h" class="t">Rechner: Reicht eine Akkuladung für deine Wohnung?</h2>

  <div class="items">
    <label class="it"><span>Zu reinigende Fläche <small class="muted">in m², ohne Bad und Flurschränke</small></span>
      <input type="number" min="5" max="400" value="70" data-qm inputmode="numeric" />
    </label>
    <label class="it"><span>Räume <small class="muted">jeder Übergang kostet Zeit</small></span>
      <input type="number" min="1" max="20" value="4" data-raeume inputmode="numeric" />
    </label>
    <label class="it"><span>Flächenleistung <small class="muted">Annahme, anpassbar</small></span>
      <select data-tempo>
        <option value="1.2">zügig, kaum Möbel (1,2 m² pro Minute)</option>
        <option value="0.9" selected>normal möbliert (0,9 m² pro Minute)</option>
        <option value="0.6">viele Stuhlbeine und Teppiche (0,6 m² pro Minute)</option>
      </select>
    </label>
    <label class="it"><span>Akkulaufzeit des Geräts <small class="muted">in Minuten laut Hersteller</small></span>
      <input type="number" min="30" max="360" value="180" data-akku inputmode="numeric" />
    </label>
  </div>

  <dl class="res">
    <div><dt>Geschätzte Reinigungsdauer</dt><dd data-dauer></dd></div>
    <div><dt>Nötige Akkulaufzeit mit Reserve</dt><dd data-noetig></dd></div>
  </dl>
  <p class="small" data-hint></p>

  <p class="small muted note">
    Die Flächenleistung ist eine Rechenannahme, keine Messung. Hersteller geben sie nicht einheitlich an,
    deshalb kannst du sie oben umstellen. Teppich, Eco- und Turbomodus und das Nachladen zwischendurch
    verschieben das Ergebnis.
  </p>
  <a class="btn btn-ghost" href="/saugroboter/saugroboter-mit-absaugstation/">Saugroboter vergleichen →</a>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-flaeche]').forEach((r) => {
    const qm = r.querySelector<HTMLInputElement>('[data-qm]')!;
    const raeume = r.querySelector<HTMLInputElement>('[data-raeume]')!;
    const tempo = r.querySelector<HTMLSelectElement>('[data-tempo]')!;
    const akku = r.querySelector<HTMLInputElement>('[data-akku]')!;
    const min = (n: number) => `${Math.round(n)} Minuten`;

    const up = () => {
      const flaeche = Math.max(0, Number(qm.value) || 0);
      const n = Math.max(1, Number(raeume.value) || 1);
      const rate = Number(tempo.value);
      // Grundzeit plus zwei Minuten je Raum fuer Tueren, Kanten und Umwege
      const dauer = flaeche / rate + (n - 1) * 2;
      // 20 Prozent Reserve, weil Teppich und zweite Durchgaenge Zeit kosten
      const noetig = Math.ceil((dauer * 1.2) / 10) * 10;
      const vorhanden = Math.max(0, Number(akku.value) || 0);

      r.querySelector('[data-dauer]')!.textContent = min(dauer);
      r.querySelector('[data-noetig]')!.textContent = `${noetig} Minuten`;
      r.querySelector('[data-hint]')!.textContent =
        vorhanden >= noetig
          ? 'Das passt in einem Durchgang. Achte trotzdem darauf, dass der Roboter nach dem Laden selbstständig weitermacht, falls doch einmal mehr Zeit nötig ist.'
          : 'Eine Ladung reicht rechnerisch nicht. Dann brauchst du ein Gerät, das nach dem Aufladen an der Abbruchstelle weitermacht. Diese Funktion heißt je nach Hersteller Wiederaufnahme oder Resume und steht oft nicht im Titel, sondern erst in der Beschreibung.';
    };

    [qm, raeume, tempo, akku].forEach((el) => el.addEventListener('input', up));
    tempo.addEventListener('change', up);
    up();
  });
</script>

<style>
  .calc { padding: 20px; margin: 24px 0; }
  .t { margin: 0 0 14px; font-size: 1.25rem; }
  label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: .9rem; }
  select, input[type='number'] { font: inherit; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: #fff; }
  .items { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; margin-bottom: 18px; }
  .it input[type='number'] { max-width: 140px; }
  .res { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 0 0 10px; }
  .res div { background: var(--brand-soft); border-radius: 10px; padding: 12px; }
  dt { font-size: .78rem; color: var(--muted); }
  dd { margin: 0; font-size: 1.4rem; font-weight: 800; color: var(--brand); }
  .note { margin: 10px 0 16px; max-width: 72ch; }
  @media (max-width: 600px) { .res { grid-template-columns: 1fr; } }
</style>
