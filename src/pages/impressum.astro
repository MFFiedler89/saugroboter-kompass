---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config';
const o = SITE.operator;
---
<PageLayout title="Impressum" description="Impressum und Anbieterkennzeichnung." noindex>
  <!-- Vorlage, bitte vor Livegang prüfen (z. B. mit dem Impressum-Generator von e-recht24). -->
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>{o.company && <>{o.company}<br /></>}{o.person}<br />{o.street}<br />{o.city}<br />Deutschland</p>
  <h2>Kontakt</h2>
  <p>E-Mail: <a href={`mailto:${o.email}`}>{o.email}</a></p>
  {o.vatId && <><h2>Umsatzsteuer-ID</h2><p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {o.vatId}</p></>}
  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <p>{o.person}, Anschrift wie oben</p>
  <h2>Affiliate-Hinweis</h2>
  <p>Diese Website ist Teilnehmer des Amazon-Partnerprogramms (Amazon EU-Partnerprogramm). Als Amazon-Partner verdienen wir an qualifizierten Verkäufen.</p>
  <h2>Verbraucherstreitbeilegung</h2>
  <p>Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
</PageLayout>
