---
import PageLayout from '../layouts/PageLayout.astro';
import DealCard from '../components/DealCard.astro';
import { getDeals, updatedAt, formatDateTime, kategorien, DEMO } from '../lib/catalog';
import { AMAZON, SITE } from '../config';
const deals = getDeals();
const categories = kategorien.filter((k) => deals.some((p) => p.sub && getCategory(p.sub) === k.slug));
import { subBySlug } from '../lib/catalog';
function getCategory(slug: string) { return subBySlug[slug].kategorie; }
---
<PageLayout title="Aktuelle Deals % bei Amazon" description={`Aktuelle Amazon-Angebote aus der Produktauswahl von ${SITE.name}: Rabatte in Prozent, Preise und verfügbare Aktionen im Überblick.`} wide noindex={DEMO}>
  <section class="intro">
    <p class="lead">Passende Angebote aus unserer Produktauswahl, nach dem von Amazon gemeldeten Rabatt sortiert.</p>
    <p class="small muted">Der Prozentwert bezieht sich auf den von Amazon angegebenen Vergleichspreis. Ein Rabatt allein sagt nichts über die Eignung oder den bisherigen Tiefstpreis aus.</p>
    {DEMO && <p class="notice"><strong>Demo-Vorschau:</strong> Die Produkte und Rabatte auf dieser Seite sind Beispieldaten.</p>}
    {updatedAt && <p class="small muted">Produktdaten zuletzt aktualisiert: {formatDateTime(updatedAt)}. Preise und Verfügbarkeit können sich danach ändern; maßgeblich ist das Angebot bei Amazon.</p>}
  </section>
  <section data-deals-root data-updated={updatedAt} data-max-age={AMAZON.maxPriceAgeHours} aria-label="Amazon-Angebote">
    {deals.length > 0 && (
      <div class="toolbar">
        <label>Kategorie
          <select data-deal-filter aria-label="Kategorie">
            <option value="">Alle Kategorien</option>
            {categories.map((k) => <option value={k.slug}>{k.label}</option>)}
          </select>
        </label>
        <label>Sortieren
          <select data-deal-sort aria-label="Sortieren">
            <option value="discount">Höchster Rabatt</option>
            <option value="price">Niedrigster Preis</option>
          </select>
        </label>
        <p class="count" aria-live="polite" data-deal-count>{deals.length} Angebote</p>
      </div>
    )}
    <div class="deals-grid" data-deal-grid>
      {deals.map((p, i) => <DealCard product={p} eager={i < 3} />)}
    </div>
    <div class="empty card" data-deal-empty hidden={deals.length > 0}>
      <h2>Gerade keine aktuellen Angebote verfügbar</h2>
      <p>In unserer Produktauswahl liegen derzeit keine verfügbaren Angebote mit einem von Amazon gemeldeten Rabatt und ausreichend aktuellen Daten vor. Schau später wieder vorbei oder nutze unsere Vergleiche.</p>
      <div class="comparison-links">{kategorien.map((k) => <a href={`/${k.slug}/`}>{k.label} vergleichen →</a>)}</div>
    </div>
    <noscript><p class="notice">Diese Liste zeigt den Stand der letzten Aktualisierung. Bitte prüfe vor dem Kauf Preis, Verfügbarkeit und Aktionsbedingungen bei Amazon.</p></noscript>
  </section>
  <p class="notice footnote">{AMAZON.disclosure} Die Auswahl umfasst reduzierte Produkte aus unseren Vergleichen; sie ist keine vollständige Liste aller Amazon-Angebote. Prime-Aktionen können eine Mitgliedschaft voraussetzen.</p>
</PageLayout>
<script>
  import { isFreshSnapshot, isCurrentOffer } from '../lib/deals.mjs';
  const root = document.querySelector<HTMLElement>('[data-deals-root]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-deal]')];
    const filter = root.querySelector<HTMLSelectElement>('[data-deal-filter]');
    const sort = root.querySelector<HTMLSelectElement>('[data-deal-sort]');
    const grid = root.querySelector<HTMLElement>('[data-deal-grid]');
    const empty = root.querySelector<HTMLElement>('[data-deal-empty]');
    const count = root.querySelector<HTMLElement>('[data-deal-count]');
    function update() {
      const now = Date.now();
      const fresh = isFreshSnapshot(root!.dataset.updated, Number(root!.dataset.maxAge), now);
      const ordered = [...cards].sort((a, b) => sort?.value === 'price'
        ? Number(a.dataset.amount) - Number(b.dataset.amount)
        : Number(b.dataset.discount) - Number(a.dataset.discount) || Number(a.dataset.amount) - Number(b.dataset.amount));
      let visible = 0;
      for (const card of ordered) {
        const current = isCurrentOffer({
          availability: 'IN_STOCK', amount: Number(card.dataset.amount), display: 'present',
          savingsPercent: Number(card.dataset.discount),
          deal: { startTime: card.dataset.dealStart, endTime: card.dataset.dealEnd,
            accessType: card.dataset.dealAccess, earlyAccessDurationInMilliseconds: Number(card.dataset.dealEarly) },
        }, now);
        card.hidden = !fresh || !current || (!!filter?.value && card.dataset.category !== filter.value);
        if (!card.hidden) visible++;
        grid?.append(card);
      }
      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = visible + (visible === 1 ? ' Angebot' : ' Angebote');
      // A category without remaining offers may become empty while the page is open.
      const message = empty?.querySelector('h2');
      if (message) message.textContent = fresh && filter?.value
        ? 'Gerade keine Angebote in dieser Kategorie' : 'Gerade keine aktuellen Angebote verfügbar';
    }
    filter?.addEventListener('change', update);
    sort?.addEventListener('change', update);
    window.addEventListener('pageshow', update);
    document.addEventListener('visibilitychange', update);
    window.setInterval(update, 60000);
    update();
  }
</script>
<style>
  .intro { max-width: 820px; }
  .lead { font-size: 1.13rem; }
  .toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; margin: 24px 0 18px; }
  .toolbar label { display: grid; gap: 5px; font-size: .85rem; font-weight: 650; }
  select { font: inherit; background: var(--surface); color: var(--text); padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; min-width: 190px; }
  .count { margin: 0 0 10px auto; color: var(--muted); font-size: .85rem; }
  .deals-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .empty { padding: 28px; }
  .empty[hidden] { display: none; }
  .empty h2 { margin-top: 0; }
  .comparison-links { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .footnote { margin: 24px 0 36px; }
  @media (max-width: 860px) { .deals-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) {
    .deals-grid { grid-template-columns: minmax(0, 1fr); }
    .toolbar { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .count { margin: 0; }
    select { width: 100%; min-width: 0; }
  }
</style>

