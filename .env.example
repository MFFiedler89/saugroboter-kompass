# Kopiere diese Datei zu ".env" und trage deine Werte ein. ".env" wird NICHT ins Git hochgeladen.

# Amazon Creators API (PartnerNet → Tools → Creators API)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Eigenes Partner-Tag dieser Seite, NICHT das von Ergo-Kompass
AMAZON_PARTNER_TAG=

# Nur ändern, falls die Zugangsdaten nicht für die EU-Region (Version 3.2) sind
# AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token

# Echte Domain der Seite (für Canonical-URLs und Sitemap)
SITE_URL=https://saugradar.de
